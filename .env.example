# Copie este arquivo para ".env" e preencha. Só as duas primeiras são obrigatórias.

# Token do bot — Discord Developer Portal (https://discord.com/developers/applications)
# Sua aplicação → Bot → Reset Token
DISCORD_TOKEN=

# Chave grátis do Gemini — é ela que responde as perguntas
# (Google AI Studio → https://aistudio.google.com/apikey → Create API key)
GEMINI_API_KEY=

# O nome do bot: é como você chama ele ("Jarvis, que horas são?"). Uma palavra.
BOT_NAME=Jarvis

# Opcional: ID do seu servidor — os comandos (/entrar, /sair, /ajuda) aparecem
# na hora, mas SÓ nele. Vazio = comandos em qualquer servidor (a primeira vez
# pode levar até 1h para aparecer).
# (Discord → Configurações → Avançado → Modo desenvolvedor; depois clique
# direito no servidor → Copiar ID do servidor)
GUILD_ID=

# ── Ouvir a call ─────────────────────────────────────────────────────────────
# Whisper local (roda no seu computador, só para achar o nome do bot):
# tiny = rápido, base = equilíbrio (recomendado num PC), small = mais preciso.
WHISPER_MODEL=base
# O Whisper que procura o nome no COMEÇO da frase, enquanto a pessoa ainda fala
# (é ele que faz o estalo sair na hora). tiny = ~250 ms e o que mais acerta
# em trechos curtos. Sempre local, mesmo com a chave da Groq. Numa máquina fraca
# (VM pequena) ele se desliga sozinho; "off" desliga de cara.
# WHISPER_DETECTOR=tiny

# Opcional: chave grátis da Groq (console.groq.com → API Keys) — transcrição na
# nuvem, bem melhor para reconhecer o nome. Sem ela, usa o Whisper local.
GROQ_API_KEY=
# O idioma da call para a transcrição (pt = português). Vazio = a Groq adivinha
# — numa call brasileira, 1 em cada 4 falas saiu em russo, inglês, islandês…
# VOICE_IDIOMA=pt

# ── Ajustes finos (opcionais — os padrões funcionam bem) ─────────────────────
# GEMINI_VOZ=          → a voz do bot: Puck, Zephyr, Kore, Charon… (vazio = padrão)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# FUSO=America/Sao_Paulo → o bot diz ao Gemini que horas são, neste fuso
# VOICE_CONVERSA_S=8   → depois de responder, espera a continuação SEM o nome (0 desliga)
# RESPOSTAS_NO_CHAT=0  → não escreve a pergunta e a resposta no chat (só fala)
# VOICE_SOM_ESCUTA=0   → sem o estalo de "estou ouvindo" quando alguém chama
# VOICE_GAP_S=0.8      → segundos de silêncio até considerar a frase terminada
# VOICE_MIN_RMS=250    → energia mínima (por janela de 20ms) para contar como fala;
#                        suba se o bot reage a barulho, desça se não te ouve
# VOICE_DEBUG=1        → grava os trechos em data/voice-debug e loga o texto
#                        transcrito (só para diagnóstico: é a fala das pessoas)
# GROQ_STT_RPM=20      → teto de requisições/minuto do Whisper na Groq (tier grátis)
# VOICE_WHISPER_LOCAL=0 → sem fallback para o Whisper local quando a Groq falha

# ── NVIDIA (Nemotron) — usado só pelo bot.py antigo ──────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
